# ===========================================
# Image Relay Studio - .gitignore
# ===========================================
# 原则：私密信息与 API 密钥绝不入库；开发软件配置目录不上传。

# ---------- 依赖 ----------
node_modules/
.pnp
.pnp.*
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------- 构建产物 ----------
.next/
.nuxt/
.turbo/
.vercel/
dist/
build/
out/
.rsbuild/
.parcel-cache/
.cache/
.storybook/
storybook-static/
coverage/
*.lcov
.nyc_output/
*.tsbuildinfo

# ---------- 环境变量 / 密钥（核心红线） ----------
# 任何含真实密钥的 env 文件一律忽略；只提交 .env.example 这类空模板
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# 私钥 / 证书 / 服务账号
*.pem
*.key
*.crt
*.p12
*.pfx
service-account*.json
secrets.*
credentials.*

# ---------- 开发软件配置（不上传原则） ----------
# 编辑器 / IDE 个人配置（保留共享的 extensions.json 例外）
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*~

# 操作系统
.DS_Store
._*
.DS_Store?
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Desktop.ini

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eslintcache
.stylelintcache
.node_react/
.pnpm-store/

# ---------- 项目本地调试素材（不入库） ----------
# assets/ 存放本地调试素材与个人截图，不进版本库
/assets/
# 个人本地脚本/数据
/scripts/local/
# 预览与图索引
.preview
.codegraph/
.codegraph
.coze-logs
.cozeproj/reduction

# ---------- 日志 ----------
*.log
*.log.*
logs/
output.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 运行时 ----------
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.tmp
*.temp
.tmp/
.temp/

# ---------- 大文件 / 二进制媒体 ----------
# 视频与归档不进版本库，避免仓库膨胀；如需分发请走 release 附件或外部存储
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.webm
*.m4v
*.mpeg
*.mpg
*.3gp
*.f4v
*.rmvb
*.vob

*.iso
*.dmg
*.rar
*.zip
*.gz
*.tar
*.tgz

# 文档类二进制（默认排除，个别需要的用 git add -f 强加）
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.ppt
*.pptx
*.csv

# ---------- 其他 ----------
/vendor
bin/
*.test
*.o
*.a
*.swp
pids/
.optional-files
