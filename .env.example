# ===========================================
# Image Relay Studio - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# NEVER commit real secrets to version control.

# ---------- Supabase (DB / Auth / Storage) ----------
# The server-side Supabase client (src/storage/database/supabase-client.ts)
# reads the COZE_SUPABASE_* prefix because the platform auto-injects that form.
# The NEXT_PUBLIC_* variants are a CLIENT-SAFE mirror read by the browser client
# (src/lib/supabase-browser.ts). Both forms MUST point at the same project.
#
# Required for server runtime (read by supabase-client.ts):
COZE_SUPABASE_URL=
# Anon/public key — safe to expose, used for RLS-scoped calls (SERVER + CLIENT):
COZE_SUPABASE_ANON_KEY=
# Service role key — bypasses RLS, SERVER ONLY, NEVER expose to the browser:
COZE_SUPABASE_SERVICE_ROLE_KEY=
#
# Backward-compatible alias. supabase-client.ts also reads this as a fallback
# for the service role key when COZE_SUPABASE_SERVICE_ROLE_KEY is absent.
# Leave it unset if COZE_SUPABASE_SERVICE_ROLE_KEY is already provided.
SUPABASE_SERVICE_ROLE_KEY=
#
# Client-safe copies (NEXT_PUBLIC_* are inlined into the browser bundle at
# build time, so the browser can reach Supabase directly without a config
# round-trip). Must equal the COZE_SUPABASE_* values above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Admin Bootstrap ----------
# Email of the first admin user
BOOTSTRAP_ADMIN_EMAIL=
# Password for the first admin (optional - auto-generated if not set)
BOOTSTRAP_ADMIN_PASSWORD=
# Bootstrap token for security (required in production)
# In PROD: must be set and passed via X-Bootstrap-Token header
# In DEV: optional, but if set must also be passed
BOOTSTRAP_TOKEN=

# ---------- API Key Security ----------
# Pepper for API key hashing (generate a random 32+ char string)
API_KEY_HASH_PEPPER=

# ---------- Object Storage ----------
# Auto-injected by platform
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
# Public origin of the S3-compatible storage endpoint (client-side preconnect hint).
# Leave empty to skip the preconnect (no infrastructure hint leaked to the browser).
# Example: https://s3.cn-beijing.amazonaws.com.cn
NEXT_PUBLIC_STORAGE_HOST=

# ---------- Coze Provider ----------
# Coze API base URL (if using Coze API directly)
COZE_API_BASE_URL=
# Coze API token for model access (SERVER ONLY)
COZE_API_TOKEN=

# ---------- Runtime ----------
# DEV | PROD
COZE_PROJECT_ENV=DEV
# Application port. DEPLOY_RUN_PORT takes precedence in the bundled scripts.
DEPLOY_RUN_PORT=5000
PORT=5000
# Default retention days for data cleanup
DEFAULT_RETENTION_DAYS=90

# ---------- Optional API smoke test ----------
# Use a dedicated, least-privilege key. Never place a production key here.
IRS_TEST_BASE_URL=http://localhost:5000
IRS_TEST_API_KEY=
