# ===========================================
# Image Relay Studio - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# NEVER commit real secrets to version control.

# ---------- Authentication ----------
# Supabase project URL (auto-injected by platform)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (auto-injected by platform, safe for client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (SERVER ONLY, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin Bootstrap ----------
# Email of the first admin user
BOOTSTRAP_ADMIN_EMAIL=
# Password for the first admin (optional - auto-generated if not set)
BOOTSTRAP_ADMIN_PASSWORD=
# Bootstrap token for security (required in production)
# In PROD: must be set and passed via X-Bootstrap-Token header
# In DEV: optional, but if set must also be passed
BOOTSTRAP_TOKEN=

# ---------- API Key Security ----------
# Pepper for API key hashing (generate a random 32+ char string)
API_KEY_HASH_PEPPER=

# ---------- Object Storage ----------
# Auto-injected by platform
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=

# ---------- Coze Provider ----------
# Coze API base URL (if using Coze API directly)
COZE_API_BASE_URL=
# Coze API token for model access (SERVER ONLY)
COZE_API_TOKEN=
# Default workflow ID for image generation
COZE_WORKFLOW_ID=

# ---------- Internal ----------
# Secret for internal dispatcher API
INTERNAL_DISPATCHER_SECRET=
# Prompt logging mode: full | redacted | disabled
PROMPT_LOGGING_MODE=redacted
# Default retention days for data cleanup
DEFAULT_RETENTION_DAYS=90
